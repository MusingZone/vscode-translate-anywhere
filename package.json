{
  "name": "vscode-translate-anywhere",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.6.0",
  "publisher": "MusingZone",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MusingZone/vscode-translate-anywhere.git"
  },
  "bugs": {
    "url": "https://github.com/MusingZone/vscode-translate-anywhere/issues"
  },
  "homepage": "https://github.com/MusingZone/vscode-translate-anywhere#readme",
  "keywords": [
    "translate",
    "translation",
    "translator",
    "dictionary",
    "chinese",
    "hover",
    "select",
    "chat",
    "markdown",
    "bilingual",
    "vocabulary",
    "ai translate",
    "翻译",
    "划词翻译",
    "段落翻译",
    "全文翻译",
    "中英翻译",
    "英汉词典",
    "AI翻译",
    "翻译插件",
    "德语"
  ],
  "categories": [
    "Education",
    "Other"
  ],
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./src/extension.js",
  "scripts": {
    "vscode:uninstall": "node ./tools/uninstall.js",
    "test": "node --test test/core.test.js",
    "package": "node tools/package.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "translateAnywhere.enable",
        "category": "Translate Anywhere",
        "title": "%command.enable%"
      },
      {
        "command": "translateAnywhere.disable",
        "category": "Translate Anywhere",
        "title": "%command.disable%"
      },
      {
        "command": "translateAnywhere.openSettings",
        "category": "Translate Anywhere",
        "title": "%command.openSettings%",
        "icon": "$(gear)"
      },
      {
        "command": "translateAnywhere.selectModel",
        "category": "Translate Anywhere",
        "title": "%command.selectModel%"
      },
      {
        "command": "translateAnywhere.authorizeAI",
        "category": "Translate Anywhere",
        "title": "%command.authorizeAI%"
      },
      {
        "command": "translateAnywhere.tryIt",
        "category": "Translate Anywhere",
        "title": "%command.tryIt%"
      },
      {
        "command": "translateAnywhere.openMarkdownAsPreview",
        "category": "Translate Anywhere",
        "title": "%command.openMarkdownAsPreview%"
      },
      {
        "command": "translateAnywhere.openMarkdownAsText",
        "category": "Translate Anywhere",
        "title": "%command.openMarkdownAsText%"
      },
      {
        "command": "translateAnywhere.openSurfaceSettings",
        "category": "Translate Anywhere",
        "title": "%command.openSurfaceSettings%"
      },
      {
        "command": "translateAnywhere.openVocabulary",
        "category": "Translate Anywhere",
        "title": "%command.openVocabulary%"
      },
      {
        "command": "translateAnywhere.exportVocabulary",
        "category": "Translate Anywhere",
        "title": "%command.exportVocabulary%"
      },
      {
        "command": "translateAnywhere.removeVocabulary",
        "category": "Translate Anywhere",
        "title": "%command.removeVocabulary%"
      },
      {
        "command": "translateAnywhere.status",
        "category": "Translate Anywhere",
        "title": "%command.status%"
      },
      {
        "command": "translateAnywhere.selectProvider",
        "category": "Translate Anywhere",
        "title": "%command.selectProvider%"
      },
      {
        "command": "translateAnywhere.setApiKey",
        "category": "Translate Anywhere",
        "title": "%command.setApiKey%"
      },
      {
        "command": "translateAnywhere.downloadDictionary",
        "category": "Translate Anywhere",
        "title": "%command.downloadDictionary%"
      },
      {
        "command": "translateAnywhere.downloadGermanDictionary",
        "category": "Translate Anywhere",
        "title": "%command.downloadGermanDictionary%"
      },
      {
        "command": "translateAnywhere.chooseDictionaryFile",
        "category": "Translate Anywhere",
        "title": "%command.chooseDictionaryFile%"
      },
      {
        "command": "translateAnywhere.useDefaultDictionary",
        "category": "Translate Anywhere",
        "title": "%command.useDefaultDictionary%"
      },
      {
        "command": "translateAnywhere.showLog",
        "category": "Translate Anywhere",
        "title": "%command.showLog%",
        "icon": "$(output)"
      }
    ],
    "configuration": {
      "title": "Translate Anywhere",
      "properties": {
        "translateAnywhere.targetLanguage": {
          "type": "string",
          "default": "zh-CN",
          "scope": "application",
          "order": 1,
          "enum": [
            "zh-CN",
            "zh-TW",
            "en",
            "ja",
            "ko",
            "fr",
            "de",
            "es",
            "pt",
            "it",
            "ru",
            "uk",
            "ar",
            "hi",
            "vi",
            "th",
            "id",
            "tr",
            "pl",
            "nl"
          ],
          "enumItemLabels": [
            "简体中文 (zh-CN)",
            "繁體中文 (zh-TW)",
            "English",
            "日本語",
            "한국어",
            "Français",
            "Deutsch",
            "Español",
            "Português",
            "Italiano",
            "Русский",
            "Українська",
            "العربية",
            "हिन्दी",
            "Tiếng Việt",
            "ไทย",
            "Bahasa Indonesia",
            "Türkçe",
            "Polski",
            "Nederlands"
          ],
          "markdownDescription": "%config.targetLanguage%"
        },
        "translateAnywhere.uiLanguage": {
          "type": "string",
          "default": "auto",
          "scope": "application",
          "order": 2,
          "enum": [
            "auto",
            "en",
            "zh-CN",
            "de"
          ],
          "enumItemLabels": [
            "Auto (follow VS Code)",
            "English",
            "简体中文",
            "Deutsch"
          ],
          "markdownDescription": "%config.uiLanguage%"
        },
        "translateAnywhere.surfaces": {
          "type": "object",
          "scope": "application",
          "order": 3,
          "properties": {
            "markdownPreview": {
              "type": "boolean",
              "description": "%config.surfaces.markdownPreview%"
            },
            "releaseNotes": {
              "type": "boolean",
              "description": "%config.surfaces.releaseNotes%"
            },
            "chat": {
              "type": "boolean",
              "description": "%config.surfaces.chat%"
            },
            "settings": {
              "type": "boolean",
              "description": "%config.surfaces.settings%"
            },
            "extensionPages": {
              "type": "boolean",
              "description": "%config.surfaces.extensionPages%"
            },
            "welcome": {
              "type": "boolean",
              "description": "%config.surfaces.welcome%"
            },
            "workbenchUI": {
              "type": "boolean",
              "description": "%config.surfaces.workbenchUI%"
            }
          },
          "additionalProperties": false,
          "default": {
            "markdownPreview": true,
            "releaseNotes": true,
            "chat": true,
            "settings": true,
            "extensionPages": true,
            "welcome": true,
            "workbenchUI": true
          },
          "markdownDescription": "%config.surfaces%"
        },
        "translateAnywhere.shortcuts.paragraph": {
          "type": "string",
          "default": "Alt+Z",
          "scope": "application",
          "order": 4,
          "pattern": "^$|^(([Cc]trl|[Aa]lt|[Ss]hift|[Mm]eta)\\+)*([A-Za-z0-9`]|[Ff]([1-9]|1[0-9]|2[0-4])|[Ss]pace)$",
          "patternErrorMessage": "%config.shortcuts.error%",
          "markdownDescription": "%config.shortcuts.paragraph%"
        },
        "translateAnywhere.shortcuts.fullPage": {
          "type": "string",
          "default": "Alt+W",
          "scope": "application",
          "order": 5,
          "pattern": "^$|^(([Cc]trl|[Aa]lt|[Ss]hift|[Mm]eta)\\+)*([A-Za-z0-9`]|[Ff]([1-9]|1[0-9]|2[0-4])|[Ss]pace)$",
          "patternErrorMessage": "%config.shortcuts.error%",
          "markdownDescription": "%config.shortcuts.fullPage%"
        },
        "translateAnywhere.fullPage.mode": {
          "type": "string",
          "default": "translationOnly",
          "scope": "application",
          "order": 6,
          "enum": [
            "translationOnly",
            "bilingual"
          ],
          "enumDescriptions": [
            "%config.fullPage.mode.translationOnly%",
            "%config.fullPage.mode.bilingual%"
          ],
          "markdownDescription": "%config.fullPage.mode%"
        },
        "translateAnywhere.ai.autoTranslate": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 7,
          "markdownDescription": "%config.ai.autoTranslate%"
        },
        "translateAnywhere.ai.provider": {
          "type": "string",
          "default": "vscode",
          "scope": "application",
          "order": 8,
          "enum": [
            "vscode",
            "openai",
            "anthropic",
            "gemini",
            "deepseek",
            "qwen",
            "moonshot",
            "zhipu",
            "siliconflow",
            "openrouter",
            "groq",
            "mistral",
            "ollama",
            "custom"
          ],
          "enumItemLabels": [
            "VS Code Language Models",
            "OpenAI",
            "Anthropic Claude",
            "Google Gemini",
            "DeepSeek",
            "Alibaba Qwen (DashScope)",
            "Moonshot Kimi",
            "Zhipu GLM",
            "SiliconFlow",
            "OpenRouter",
            "Groq",
            "Mistral AI",
            "Ollama (local)",
            "Custom (OpenAI-compatible)"
          ],
          "markdownDescription": "%config.ai.provider%"
        },
        "translateAnywhere.ai.modelId": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 9,
          "markdownDescription": "%config.ai.modelId%"
        },
        "translateAnywhere.ai.apiModel": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 10,
          "markdownDescription": "%config.ai.apiModel%"
        },
        "translateAnywhere.ai.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 11,
          "pattern": "^$|^https?://",
          "patternErrorMessage": "%config.ai.baseUrl.error%",
          "markdownDescription": "%config.ai.baseUrl%"
        },
        "translateAnywhere.dictionary.autoDownload": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 12,
          "markdownDescription": "%config.dictionary.autoDownload%"
        },
        "translateAnywhere.dictionary.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 13,
          "markdownDescription": "%config.dictionary.path%"
        },
        "translateAnywhere.dictionary.downloadUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 14,
          "pattern": "^$|^https://",
          "patternErrorMessage": "%config.dictionary.downloadUrl.error%",
          "markdownDescription": "%config.dictionary.downloadUrl%"
        },
        "translateAnywhere.dictionary.german": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 15,
          "markdownDescription": "%config.dictionary.german%"
        },
        "translateAnywhere.integration.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "order": 20,
          "markdownDescription": "%config.integration.enabled%"
        },
        "translateAnywhere.integration.autoRepair": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 21,
          "markdownDescription": "%config.integration.autoRepair%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "translateAnywhere",
          "title": "Translate Anywhere",
          "icon": "images/sidebar.svg"
        }
      ]
    },
    "views": {
      "translateAnywhere": [
        {
          "type": "webview",
          "id": "translateAnywhere.panel",
          "name": "%view.panel%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "translateAnywhere.showLog",
          "when": "view == translateAnywhere.panel",
          "group": "navigation@1"
        },
        {
          "command": "translateAnywhere.openSettings",
          "when": "view == translateAnywhere.panel",
          "group": "navigation@2"
        }
      ]
    }
  }
}
